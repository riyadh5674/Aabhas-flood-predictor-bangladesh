# Aabhas Flood Predictor — Environment Variables
# Copy to .env and fill in values for local development
# For production, set these in GitHub Secrets and HF Spaces Settings

# ============================================================
# HUGGING FACE (Production API + Feature Store)
# ============================================================
# HF Space ID (format: username/space-name) - create on huggingface.co/spaces
HF_SPACE_ID=your-username/aabhas-flood-api

# HF Dataset for feature store (format: username/dataset-name) - create on huggingface.co/datasets
HF_FEATURE_DATASET=your-username/aabhas-flood-features

# HF Token with write access to Spaces and Datasets (Settings → Access Tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# ============================================================
# CLOUDFLARE PAGES (Optional - not used; primary hosting is the
# static HF Space, configured with HF_SPACE_ID above)
# ============================================================
# Get from Cloudflare Dashboard → My Profile → API Tokens
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Cloudflare Pages project name (create in Cloudflare Pages first)
CF_PAGES_PROJECT=aabhas-bangladesh-outlook

# ============================================================
# API CONFIGURATION
# ============================================================
# Enable preview mode (Basic Auth) - set to "true" for staging
AABHAS_PREVIEW_MODE=false
AABHAS_PREVIEW_USER=preview
AABHAS_PREVIEW_PASSWORD=changeme

# Local development: use local feature store (leave HF_FEATURE_DATASET empty)
# Production: set HF_FEATURE_DATASET to enable HF Datasets feature store
# HF_FEATURE_DATASET=your-username/aabhas-flood-features
# HF_FEATURE_REVISION=main

# ============================================================
# FFWC INGESTION (Optional - for daily pipeline)
# ============================================================
# FFWC internal API key (if you have one)
# FFWC_INTERNAL_KEY=FFWC-Project-2026-Secure-V1

# ============================================================
# LOCAL DEVELOPMENT OVERRIDES
# ============================================================
# Python path for local imports
PYTHONPATH=/app

# Model path (relative to project root)
MODEL_PATH=models/final_v2/selected_model_v2.pkl