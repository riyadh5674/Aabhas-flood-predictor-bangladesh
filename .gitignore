# --- environment ---
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# --- bulk data: too large for git, reproducible via scripts/ + src/flood/ingest ---
data/raw/ffwc/waterlevel/
data/raw/rainfall/weather_station_daily.csv
data/processed/flood_dataset.csv
data/processed/flood_dataset_model_ready*.csv
data/raw/ffwc/*.html

# --- geospatial bulk data (SRTM/OSM/geoBoundaries) - keep the provenance manifest only ---
data/raw/geo/*
!data/raw/geo/README.md

# --- processed bulk data: large / regenerable (manifests + small tables stay tracked) ---
data/processed/experimental_dataset.csv
data/processed/split_assignments.csv
data/processed/sequence_index.csv
data/processed/*.npy

# --- generated frontend artifacts (rebuild locally, deploy to HF static Space) ---
system/web/node_modules/
system/web/dist/
system/web/public/data/snapshot/
*.tsbuildinfo

# --- runtime logs ---
system/logs/

# --- runtime feature store + raw caches (published to HF Datasets, not git) ---
system/data/processed/model_ready/
system/data/raw/

# --- transient outputs ---
scripts/*.err
scripts/*.err.*
scripts/*.out.txt
scripts/*.stdout.log
scripts/*.stderr.log
scripts/*_console.*
scripts/*.pid
